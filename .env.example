DATABASE_URL=postgres://postgres:password@localhost:5432/database
PORT=3030

# Public origin used for email links and session-cookie security.
APP_URL=http://localhost:3030

# Shared secret used to pseudonymize rate-limit keys across replicas.
# Generate at least 32 random characters, for example: openssl rand -hex 32
RATE_LIMIT_SECRET=

# Exact reverse-proxy addresses allowed to supply X-Forwarded-For.
# Loopback is trusted by default for a same-host Caddy deployment.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional rate-limit and image-cache overrides.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX=5
# RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
# RATE_LIMIT_PASSWORD_RESET_MAX=10
# RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600
# RATE_LIMIT_EMAIL_CONFIRMATION_MAX=10
# RATE_LIMIT_EMAIL_CONFIRMATION_WINDOW_SECONDS=3600
# RATE_LIMIT_IMAGE_TRANSFORM_MAX=30
# RATE_LIMIT_IMAGE_TRANSFORM_WINDOW_SECONDS=60
# MAX_ASSET_CACHE_BYTES=536870912
# MAX_ASSET_CACHE_FILES=10000
# MAX_ASSET_CACHE_VARIANTS_PER_ASSET=20
# MAX_CONCURRENT_IMAGE_TRANSFORMS=2
# MAX_QUEUED_IMAGE_TRANSFORMS=32
# ASSET_CACHE_EVICTION_GRACE_MS=60000

# Optional override. By default session cookies are Secure when APP_URL uses https
# (or NODE_ENV=production). Uncomment only if the automatic choice is unsuitable.
# SESSION_COOKIE_SECURE=true

# SMTP configuration (MAIL_SECURE=true is normally used with port 465).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Bunsai

# Original asset storage: local (default) or s3. Image variants stay cached locally.
# Each database row retains its backend; this does not migrate existing files.
ASSET_STORAGE=local
# Configure these for S3 outside Docker. Compose supplies its own MinIO settings.
# S3_BUCKET=bunsai
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=bunsai
# S3_SECRET_ACCESS_KEY=bunsai-local-password
# S3_SESSION_TOKEN=
# S3_VIRTUAL_HOSTED_STYLE=false
# Use HTTPS endpoints in production; omit S3_ENDPOINT for native AWS S3.
# RATE_LIMIT_S3_ASSET_UPLOAD_MAX=10
# RATE_LIMIT_S3_ASSET_UPLOAD_WINDOW_SECONDS=60
# RATE_LIMIT_S3_ASSET_DOWNLOAD_MAX=60
# RATE_LIMIT_S3_ASSET_DOWNLOAD_WINDOW_SECONDS=60

# Optional local Docker Compose overrides (development credentials only).
# POSTGRES_PASSWORD must be URL-safe because Compose embeds it in DATABASE_URL.
# POSTGRES_PASSWORD=password
# POSTGRES_PORT=5432
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# MINIO_ROOT_USER=bunsai
# MINIO_ROOT_PASSWORD=bunsai-local-password
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Compose provides S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID and
# S3_SECRET_ACCESS_KEY to Bun. For host-side tests use http://localhost:9000.
