DATABASE_URL=postgres://postgres:password@localhost:5432/database
PORT=3030

# Public origin used for email links and session-cookie security.
APP_URL=http://localhost:3030

# Optional override. By default session cookies are Secure when APP_URL uses https
# (or NODE_ENV=production). Uncomment only if the automatic choice is unsuitable.
# SESSION_COOKIE_SECURE=true

# SMTP configuration (MAIL_SECURE=true is normally used with port 465).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Bunsai
