{
  "name": "bunsai",
  "version": "0.1.0",
  "description": "Thin full-stack Bun starter: backend, frontend (Preact), auth, migrations and CLI.",
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianomorando/bunsai.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianomorando/bunsai/issues"
  },
  "homepage": "https://github.com/sebastianomorando/bunsai#readme",
  "keywords": [
    "bun",
    "typescript",
    "fullstack",
    "preact",
    "signals",
    "preact-iso",
    "template",
    "starter",
    "decorators",
    "auth"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "migrate": "bun run migrate.ts",
    "seed": "bun run seed.ts",
    "maintenance": "bun run cli/maintenance.ts run",
    "maintenance:install": "bun run cli/maintenance.ts install",
    "maintenance:remove": "bun run cli/maintenance.ts remove",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test --parallel=4",
    "test:serial": "bun test",
    "test:changed": "bun test --changed",
    "test:decorators": "bun test server/decorators.test.ts",
    "audit": "bun audit",
    "deps:check": "bun dedupe --check",
    "licenses": "bun pm licenses"
  },
  "bun-create": {
    "preinstall": "echo \"Initializing Bunsai template...\"",
    "postinstall": [
      "echo \"Project created successfully.\"",
      "echo \"Next steps: cp .env.example .env && bun run migrate && bun run dev\""
    ],
    "start": "bun run dev"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/nodemailer": "^7.0.12"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "nodemailer": "^9.0.5",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  }
}
